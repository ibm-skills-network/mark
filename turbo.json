{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/dev.env"],
  "ui": "stream",
  "tasks": {
    "download-models": {},
    "build": {
      "dependsOn": ["^build", "^download-models"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "seed": {},
    "seed:update": {},
    "lint:staged": {},
    "dev": {
      "dependsOn": ["^download-models"],
      "cache": false,
      "persistent": true
    },
    "dev:e2e": {
      "dependsOn": ["^download-models"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "test:staged": {
      "dependsOn": []
    }
  }
}
