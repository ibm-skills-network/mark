###############################################################################
#  .env.template               (✱ do NOT place secrets here – ever ✱)
###############################################################################

# ────── Front-end ──────
PORT=                  # e.g. 3010

# ────── Back-end API ──────
API_PORT=              # e.g. 4222
MARK_API_ENDPOINT=     # e.g. http://localhost:4222, used by jobs worker
MARK_API_JOB_EXECUTOR_URL= # optional exact internal jobs endpoint override
JOB_WORKER_CONNECT_RETRY_DELAY_MS= # e.g. 5000
JOB_WORKER_HEARTBEAT_INTERVAL_MS= # e.g. 10000
JOB_WORKER_HEARTBEAT_TTL_SECONDS= # e.g. 30
# ────── API Gateway ──────
API_GATEWAY_PORT=      # e.g. 8000
API_GATEWAY_HOST=      # e.g. http://localhost:8000

# ────── Feature Flags / Misc ──────
DEBUG_MODE=            # true | false

# ────── PostgreSQL ──────
POSTGRES_HOST=         # e.g. localhost
POSTGRES_PORT=         # e.g. 5432
POSTGRES_USER=         # e.g. mark-pg-user
POSTGRES_PASSWORD=     # ← secret!
POSTGRES_DB=           # e.g. mark-pg

###############################################################################
#  Add other variables (JWT_SECRET, REDIS_URL, etc.) below this line as needed
REDIS_URL=redis://localhost:6379
JOB_QUEUE_SECRET=        # shared secret used to encrypt job payloads between API and jobs worker
###############################################################################
