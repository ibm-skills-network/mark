{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "clean": "rimraf dist && rimraf node_modules",
    "dev": "yarn start:dev",
    "dev:e2e": "yarn dev",
    "check": "yarn lint && yarn test && yarn prisma:generate && yarn build",
    "format": "prettier --ignore-unknown --write .",
    "format:staged": "prettier --ignore-unknown --write",
    "lint": "eslint .",
    "lint:staged": "eslint",
    "start": "dotenv -e ./dev.env -- nest start",
    "start:e2e": "yarn start",
    "start:debug": "yarn start --debug --watch",
    "start:dev": "yarn start --watch",
    "start:prod": "node dist/main",
    "test": "jest --detectOpenHandles --forceExit",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:job-queue": "jest --detectOpenHandles --runInBand --runTestsByPath src/job-queue/job-payload.crypto.spec.ts src/job-queue/job-queue.service.spec.ts src/job-queue/job-state.service.spec.ts src/job-queue/job-queue.integration.spec.ts src/api/Job/job-status.service.spec.ts src/api/assignment/v2/tests/unit/services/job-status.service.spec.ts",
    "test:job-queue:e2e": "jest --runInBand --config ./test/jest-e2e.json --runTestsByPath ./test/job-queue.e2e-spec.ts",
    "test:job-queue:stress": "RUN_JOB_QUEUE_STRESS_TESTS=true jest --detectOpenHandles --runInBand --runTestsByPath src/job-queue/job-queue.stress.spec.ts",
    "test:job-queue:performance": "RUN_JOB_QUEUE_PERF_TESTS=true jest --detectOpenHandles --runInBand --runTestsByPath src/job-queue/job-queue.performance.spec.ts",
    "test:staged": "jest --bail --findRelatedTests --passWithNoTests --collectCoverage=false",
    "test:watch": "jest --watch",
    "create-initial-versions": "dotenv -e ./dev.env -- ts-node src/scripts/create-initial-versions.ts",
    "translation-audit": "node dist/src/scripts/translation-audit.js",
    "verify-migration": "dotenv -e ./dev.env -- ts-node scripts/verify-migration.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
