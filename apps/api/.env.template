###############################################################################
#  .env.template  – tracked by Git
#  DO NOT store plaintext secrets here.
###############################################################################

# ────── Runtime ──────
NODE_ENV=development                   # development | staging | production
API_PORT=4222

# ────── NATS Messaging ──────
NATS_USERNAME= # enter your secret here
NATS_PASSWORD= # enter your secret here
NATS_URL= # enter your secret here
NATS_ORGANIZATION= # enter your secret here
NATS_PROGRAM= # enter your secret here
NATS_PROJECT= # enter your secret here

# ────── OpenAI & watsonx.ai ──────
OPENAI_API_KEY= # enter your secret here
WATSONX_AI_API_KEY= # enter your secret here
WATSONX_PROJECT_ID= # enter your secret here
# Bump when a rolling model or grading semantics change to invalidate cached grades.
GRADING_CACHE_REVISION=2026-08-05-gpt56

# ────── PostgreSQL ──────
# Use an op:// URI or leave blank; never commit raw URLs with passwords.
DATABASE_URL= # enter your secret here
DATABASE_URL_DIRECT= # enter your secret here
REDIS_URL=redis://localhost:6379
JOB_QUEUE_SECRET=mark-local-job-queue-key-change-me # pragma: allowlist secret
MARK_API_ENDPOINT=http://localhost:4222
MARK_API_JOB_EXECUTOR_URL=
JOB_WORKER_CONNECT_RETRY_DELAY_MS=5000
JOB_WORKER_HEARTBEAT_INTERVAL_MS=10000
JOB_WORKER_HEARTBEAT_TTL_SECONDS=30

# ────── GitHub OAuth / App ──────
GITHUB_CLIENT_ID= # enter your secret here
GITHUB_CLIENT_SECRET= # enter your secret here
GITHUB_CLIENT_ID_LOCAL= # enter your secret here
GITHUB_CLIENT_SECRET_LOCAL= # enter your secret here
GITHUB_APP_TOKEN= # enter your secret here
GITHUB_OWNER= # enter your secret here
GITHUB_REPO= # enter your secret here

# ────── LTI Gateway ──────
GRADING_LTI_GATEWAY_URL=http://localhost:4010/lti/1.1/grade

# ────── Worker Concurrency ──────
# Bottleneck maxConcurrent ceiling on parallel LLM calls inside a single
# grading job (the wave-scheduler fan-out cap). Distinct from
# GRADING_WORKER_CONCURRENCY in apps/jobs, which controls how many grading
# JOBS the BullMQ worker pulls in parallel per pod.
GRADING_CONCURRENCY=10

# ────── Translation Settings ──────
ENABLE_TRANSLATION=false # true | false

# Optional server-side token for grading's GitHub API calls (see github-grading-token.ts) — never a learner token
GITHUB_GRADING_API_TOKEN= # enter your secret here
