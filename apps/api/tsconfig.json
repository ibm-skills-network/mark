{
  "extends": "tsconfig/nestjs.json",
  "compilerOptions": {
    "lib": ["es2021", "dom"],
    "types": ["node"],
    "outDir": "./dist",
    "baseUrl": "./",
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "./ensureDb.js",
    "test",
    "dist",
    "**/*spec.ts",
    "**/*.test.ts",
    "**/tests/**"
  ]
}
