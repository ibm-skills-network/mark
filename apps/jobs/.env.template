###############################################################################
#  .env.template  -  tracked by Git (mark-jobs)
#  DO NOT store plaintext secrets here.
###############################################################################

# ----- Runtime -----
NODE_ENV=development                  # development | staging | production

# ----- PostgreSQL (required - mark-jobs imports DatabaseModule on boot) -----
DATABASE_URL=                         # enter your local DSN

# ----- Redis / BullMQ -----
REDIS_URL=redis://localhost:6379
JOB_QUEUE_SECRET=mark-local-job-queue-key-change-me # pragma: allowlist secret

# ----- Mark API URL resolution chain (used by forwardJobToApi fallback) -----
# Resolution order: MARK_API_JOB_EXECUTOR_URL -> MARK_API_ENDPOINT -> MARK_API_URL -> http://localhost:${API_PORT:-4222}
MARK_API_JOB_EXECUTOR_URL=
MARK_API_ENDPOINT=http://localhost:4222
MARK_API_URL=

# ----- Worker config -----
GRADING_CONCURRENCY=4
TRANSLATION_CONCURRENCY=8             # BullMQ Worker concurrency for the mark.assignment.v2.translations queue; default 8
JOB_WORKER_HEARTBEAT_INTERVAL_MS=10000
JOB_WORKER_HEARTBEAT_TTL_SECONDS=30

# ----- Feature flags -----
JOBS_EXECUTE_LOCALLY=                 # default OFF; only the literal string "true" enables local job execution
ENABLE_LTI_SCHEDULER=false            # mark-jobs should not run the LTI cron - mark-api owns it
ENABLE_JOB_SCHEDULERS=true            # required by existing scheduler short-circuit
ENABLE_TRANSLATION=true               # required by SharedModule TranslationService ctor - undefined throws on boot
