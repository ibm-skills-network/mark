{
  "name": "jobs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "yarn start:dev",
    "format": "prettier --ignore-unknown --write .",
    "format:staged": "prettier --ignore-unknown --write",
    "lint": "eslint .",
    "lint:staged": "eslint",
    "start": "dotenv -e ../api/dev.env -- nest start",
    "start:debug": "yarn start --debug --watch",
    "start:dev": "yarn start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:job-worker": "jest --runInBand --runTestsByPath src/job-worker.service.spec.ts",
    "test:staged": "jest --bail --findRelatedTests --passWithNoTests --collectCoverage=false",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "10.4.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "10.4.17",
    "bullmq": "^5.21.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "nest-winston": "^1.9.2",
    "reflect-metadata": "0.2.0",
    "rxjs": "7.8.1",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-unicorn": "^47.0.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "prettier-plugin-pkg": "^0.19.0",
    "prettier-plugin-sh": "^0.17.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
