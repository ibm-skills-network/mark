{
  "name": "mark",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=7.0.0"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "noHoist": [
      "**/@nestjs/platform-express"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "build:docker": "docker buildx build -f ./apps/api-gateway/Dockerfile -t mark-api-gateway --no-cache --platform linux/amd64 . &> build-gateway.log && docker buildx build -f ./apps/web/Dockerfile -t mark-web --no-cache --platform linux/amd64 . &> build-web.log && docker buildx build -f ./apps/api/Dockerfile -t mark-api --no-cache --platform linux/amd64 . &> build-api.log && docker buildx build -f ./apps/jobs/Dockerfile -t mark-jobs --no-cache --platform linux/amd64 . &> build-jobs.log",
    "db": "scripts/start-db.sh",
    "db:stop": "docker-compose stop",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && scripts/start-db.sh",
    "db:logs": "docker-compose logs -f postgres",
    "seed": "scripts/seed.sh",
    "dev": "scripts/dev.sh",
    "dev:e2e": "MARK_DEV_TASK=dev:e2e scripts/dev.sh",
    "format": "prettier --ignore-unknown --write .",
    "format:staged": "prettier --ignore-unknown --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md,html}\"",
    "lint": "turbo run lint -- --fix",
    "lint:staged": "turbo run lint:staged --",
    "postinstall": "patch-package",
    "prepare": "husky install",
    "prisma:generate": "cd ./apps/api && source dev.env && prisma generate",
    "prisma:migrate": "cd ./apps/api && source dev.env && prisma migrate dev",
    "prisma:studio": "cd ./apps/api && source dev.env && prisma studio",
    "prisma:reset": "cd ./apps/api && source dev.env && prisma migrate reset --force",
    "prisma:db-push": "cd ./apps/api && source dev.env && prisma db push",
    "prisma:db-pull": "cd ./apps/api && source dev.env && prisma db pull",
    "secrets:audit": "detect-secrets audit .secrets.baseline",
    "check": "yarn lint && yarn test && yarn prisma:generate && yarn build",
    "secrets:check": "scripts/detect-secrets.sh",
    "secrets:check:staged": "scripts/detect-secrets-staged.sh",
    "secrets:setup": "detect-secrets scan --update .secrets.baseline",
    "seed:update": "turbo run seed:update --filter=api",
    "setup": "scripts/setup.sh",
    "setup:no-git": "cd ./apps/api && dotenv -e ./dev.env -- npx prisma migrate dev && npx prisma generate; cd ../../",
    "test": "turbo run test",
    "test:insomnia:jobs": "scripts/test-insomnia-jobs.sh",
    "test:e2e": "playwright test --project=author-chromium --project=learner-chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:author": "playwright test --project=author-chromium --project=author-firefox --project=author-webkit",
    "test:e2e:learner": "playwright test --project=learner-chromium --project=learner-firefox --project=learner-webkit",
    "test:watch": "turbo run test --parallel ",
    "test:staged": "turbo run test:staged --",
    "test:setup": "playwright test --project=setup",
    "playwright:install": "playwright install --with-deps chromium",
    "playwright:report": "playwright show-report",
    "playwright:learner": "playwright test --project=learner-chromium --project=learner-firefox --project=learner-webkit",
    "playwright:author": "playwright test --project=author-chromium --project=author-firefox --project=author-webkit",
    "start": "scripts/start.sh",
    "start:e2e": "bash scripts/start-e2e.sh",
    "studio": "cd ./apps/api && dotenv -e ./dev.env -- npx prisma studio",
    "translation-audit:dev": "cd ./apps/api && dotenv -e ./dev.env -- ts-node src/scripts/translation-audit.ts"
  },
  "dependencies": {
    "@cypress/request": "3.0.10",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/terminus": "^11.1.1",
    "@octokit/rest": "^21.0.2",
    "@smastrom/react-rating": "^1.5.0",
    "@tabler/icons-react": "^3.16.0",
    "@tsparticles/engine": "^3.5.0",
    "@tsparticles/react": "^3.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/pdf-parse": "^1.1.4",
    "axios": "^1.16.0",
    "cookie": "^0.7.0",
    "express": "^5.1.0",
    "framer-motion": "^11.8.0",
    "jsondiffpatch": "^0.7.6",
    "lottie-react": "^2.4.0",
    "mammoth": "^1.11.0",
    "marked": "^4.0.10",
    "next": "^16.1.5",
    "node-fetch": "^2.6.7",
    "nodemailer": "^7.0.11",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^5.4.449",
    "prismjs": "1.30.0",
    "react": "^19.0.0",
    "react-circular-progressbar": "^2.1.0",
    "react-confetti": "^6.1.0",
    "react-dom": "^19.0.0",
    "react-draggable": "^4.5.0",
    "react-dropzone": "^14.2.9",
    "react-pdftotext": "^1.3.3",
    "react-select": "^5.8.2",
    "rehype-highlight": "^7.0.0",
    "remark": "^15.0.1",
    "tailwind-scrollbar-hide": "^2.0.0",
    "tar-fs": "^3.1.1",
    "tmp": "^0.2.6",
    "tsparticles": "^3.5.0",
    "undici": "6.27.0",
    "zod": "^3.23.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.9.2",
    "detect-secrets": "^1.0.6",
    "dotenv-cli": "^8.0.0",
    "husky": "^9.1.7",
    "jest-environment-jsdom": "^30.2.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-sh": "^0.17.4",
    "turbo": "^2.0.3",
    "yarn": "^1.22.22"
  },
  "resolutions": {
    "**/express": "^5.1.0",
    "**/axios": "1.16.0",
    "**/jws": "3.2.3",
    "**/qs": "6.15.2",
    "**/validator": "13.15.23",
    "**/mdast-util-to-hast": "13.2.1",
    "**/js-yaml": "4.1.1",
    "**/lodash": "4.18.1",
    "**/lodash-es": "4.18.1",
    "**/langsmith": "0.7.1",
    "tmp": "^0.2.6",
    "tar-fs": "^3.1.1",
    "jsondiffpatch": "^0.7.6",
    "prismjs": "^1.30.0",
    "node-fetch": "^2.6.7",
    "tough-cookie": "^4.1.3",
    "multer": "2.1.1",
    "**/request": "2.88.2",
    "form-data": "4.0.5",
    "**/dompurify": "3.4.10",
    "**/underscore": "1.13.8",
    "**/file-type": "21.3.2",
    "**/fast-xml-parser": "5.9.0",
    "**/@xmldom/xmldom": "^0.8.13",
    "**/postcss": "^8.5.10",
    "**/follow-redirects": "1.16.0",
    "uuid": "^11.1.1",
    "mongoose": "8.24.0",
    "socket.io-parser": "4.2.6",
    "@ai-sdk/provider-utils": "^3.0.26",
    "**/reflect-metadata": "0.2.0",
    "**/rxjs": "7.8.1",
    "**/class-transformer": "0.5.1",
    "**/class-validator": "0.15.1",
    "**/@prisma/client": "5.3.1",
    "**/prisma": "5.3.1",
    "langchain": "~1.3.4",
    "**/@langchain/core": "~1.1.46",
    "**/@langchain/openai": "~1.4.4",
    "**/@langchain/classic": "~1.0.31",
    "@ibm-cloud/watsonx-ai": "~1.6.0"
  },
  "turbo": {
    "pipeline": {
      "download-models": {
        "dependsOn": []
      },
      "dev": {
        "dependsOn": [
          "^download-models"
        ]
      },
      "dev:e2e": {
        "dependsOn": [
          "^download-models"
        ]
      },
      "build": {
        "dependsOn": [
          "^download-models"
        ]
      }
    }
  }
}
